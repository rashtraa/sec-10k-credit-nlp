# Copy to .env and fill in. .env is gitignored and never committed.

# REQUIRED. The SEC rejects requests without a contact User-Agent.
# Format: "Your Name your.email@domain.com"
SEC_USER_AGENT=Your Name your.email@domain.com

# Optional. Where this project writes its data. Defaults to ./data
# EDGAR_DATA_ROOT=X:\Projects\edgar-credit-signal\data
